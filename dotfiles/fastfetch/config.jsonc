{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ghost.txt",
    "type": "file",
    "color": {
      "1": "black" 
    },
    "padding": {
      "top": 0,
      "left": 8,   
      "right": 4
    }
  },
  "display": {
    "separator": "  ", 
    "color": {
        "separator": "white"
    }
  },
  "modules": [
    // --- HEADER ---
    {
        "type": "title",
        "keyColor": "blue" 
        // Format dihapus biar otomatis detect user@hostname yang bener
    },
    
    // --- TOP CURVE ---
    {
        "type": "custom",
        "format": "╭───────────────╯", 
        "keyColor": "blue"
    },
    
    // --- SOFTWARE ---
    {
        "type": "os",
        "key": "│   OS      ",
        "keyColor": "blue"
    },
    {
        "type": "kernel",
        "key": "│   Kernel  ",
        "keyColor": "blue"
    },
    {
        "type": "packages",
        "key": "│   Pkgs    ",
        "keyColor": "blue"
    },
    {
        "type": "wm",
        "key": "│   WM      ",
        "keyColor": "blue"
    },
    {
        "type": "terminal",
        "key": "│   Term    ",
        "keyColor": "blue"
    },

    // --- GAP ---
    {
        "type": "custom",
        "format": "│", 
        "keyColor": "blue"
    }, 

    // --- HARDWARE ---
    {
        "type": "host",
        "key": "│   PC      ",
        "keyColor": "green"
    },
    {
        "type": "cpu",
        "key": "│   CPU     ",
        "keyColor": "green"
    },
    {
        "type": "gpu",
        "key": "│   GPU     ",
        "keyColor": "green"
    },
    {
        "type": "memory",
        "key": "│   RAM     ",
        "keyColor": "green"
    },
    {
        "type": "disk",
        "key": "│   Disk    ",
        "keyColor": "green"
    },
    {
        "type": "uptime",
        "key": "│   Uptime  ",
        "keyColor": "yellow"
    },

    // --- BOTTOM CURVE ---
    {
        "type": "custom",
        "format": "╰───────────────╮", 
        "keyColor": "green"
    },
    {
        "type": "colors",
        "symbol": "circle"
    }
  ]
}
